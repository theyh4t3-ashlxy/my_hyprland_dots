#!/usr/bin/env bash
set -e

ACTION="${1:-launcher}"
CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/current_shell"
CURRENT="$(head -n 1 "$CACHE_FILE" 2>/dev/null | tr -d '[:space:]')"
[ -z "$CURRENT" ] && CURRENT="quickshell"
BRAIN_DIR="${BRAIN_SHELL_DIR:-$HOME/.local/src/Brain_Shell}"
if [ ! -d "$BRAIN_DIR" ] && [ -d "$HOME/.config/Brain_Shell" ]; then
    BRAIN_DIR="$HOME/.config/Brain_Shell"
fi

case "$ACTION" in
    launcher)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call dashboard-launcher toggle 2>/dev/null || true
        else
            qs ipc call launcher toggle 2>/dev/null || true
        fi
        ;;
    dashboard|quicksettings|home)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call dashboard-home toggle 2>/dev/null || true
        else
            qs ipc call quicksettings toggle 2>/dev/null || true
        fi
        ;;
    notifs|notifications)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call notification-toggle toggle 2>/dev/null || true
        else
            qs ipc call notifs toggle 2>/dev/null || true
        fi
        ;;
    clipboard)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call clipboard-toggle toggle 2>/dev/null || true
        else
            qs ipc call clipboard toggle 2>/dev/null || true
        fi
        ;;
    notes|quicknotes|tasks|todo)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call dashboard-kanban toggle 2>/dev/null || true
        else
            qs ipc call notes toggle 2>/dev/null || true
        fi
        ;;
    audio)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call audioOut-toggle toggle 2>/dev/null || true
        else
            qs ipc call volume toggle 2>/dev/null || true
        fi
        ;;
    screenshot)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call screenshot-toggle toggle 2>/dev/null || true
        else
            qs ipc call screenshot open 2>/dev/null || true
        fi
        ;;
    capture|screencapture)
        qs ipc call capture toggle 2>/dev/null || true
        ;;
    layout|layoutswitcher)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call layout-toggle toggle 2>/dev/null || true
        else
            qs ipc call layout toggle 2>/dev/null || true
        fi
        ;;
    wallpaper)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call wallpaper-toggle toggle 2>/dev/null || true
        else
            python3 "$HOME/.config/quickshell/scripts/wallpaper.py" random all 2>/dev/null || true
        fi
        ;;
    lock)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call lock-session toggle 2>/dev/null || true
        else
            qs ipc call lock lock 2>/dev/null || true
        fi
        ;;
    powermenu)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call PowerMenu-toggle toggle 2>/dev/null || true
        else
            qs ipc call powermenu toggle 2>/dev/null || true
        fi
        ;;
    keybinds|keys|shortcuts)
        qs ipc call keybinds toggle 2>/dev/null || true
        ;;
    welcome|intro|onboarding)
        qs ipc call welcome toggle 2>/dev/null || true
        ;;
    studio|barstudio)
        qs ipc call studio toggle 2>/dev/null || true
        ;;
    sandbox|motion)
        qs ipc call sandbox toggle 2>/dev/null || true
        ;;
    wifi)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call wifi-toggle toggle 2>/dev/null || true
        else
            qs ipc call quicksettings toggle 2>/dev/null || true
        fi
        ;;
    bluetooth|bt)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call bluetooth-toggle toggle 2>/dev/null || true
        else
            qs ipc call quicksettings toggle 2>/dev/null || true
        fi
        ;;
    vpn)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call vpn-toggle toggle 2>/dev/null || true
        else
            qs ipc call quicksettings toggle 2>/dev/null || true
        fi
        ;;
    hotspot)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call hotspot-toggle toggle 2>/dev/null || true
        else
            qs ipc call quicksettings toggle 2>/dev/null || true
        fi
        ;;
    mixer|audiomix)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call audioMix-toggle toggle 2>/dev/null || true
        else
            qs ipc call volume toggle 2>/dev/null || true
        fi
        ;;
    audioin|mic)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call audioIn-toggle toggle 2>/dev/null || true
        else
            qs ipc call volume toggle 2>/dev/null || true
        fi
        ;;
    focus|dnd)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call focus-toggle toggle 2>/dev/null || true
        else
            qs ipc call notifs toggle 2>/dev/null || true
        fi
        ;;
    stats|system)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call dashboard-stats toggle 2>/dev/null || true
        else
            uwsm app -- kitty -e btop 2>/dev/null || true
        fi
        ;;
    config|settings)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call dashboard-config toggle 2>/dev/null || true
        else
            qs ipc call quicksettings toggle 2>/dev/null || true
        fi
        ;;
    record|rec)
        if [ "$CURRENT" = "brain_shell" ] && [ -d "$BRAIN_DIR" ]; then
            qs ipc -p "$BRAIN_DIR" call screenrec-on toggle 2>/dev/null || true
        else
            shift
            SUB="${1:-toggle}"
            case "$SUB" in
                screen|display|full)
                    qs ipc call record screen 2>/dev/null || true ;;
                region|area|crop)
                    qs ipc call record region 2>/dev/null || true ;;
                window)
                    qs ipc call record window 2>/dev/null || true ;;
                stop|end)
                    qs ipc call record stop 2>/dev/null || true ;;
                discard|cancel)
                    qs ipc call record discard 2>/dev/null || true ;;
                toggle|*)
                    qs ipc call record toggle 2>/dev/null || true ;;
            esac
        fi
        ;;
    *)
        echo "Usage: qs-action {launcher|dashboard|notifs|clipboard|audio|mixer|audioin|wifi|bluetooth|vpn|hotspot|focus|stats|config|screenshot|record|wallpaper|lock|powermenu|keybinds|welcome|studio|sandbox} [subcommand]" >&2
        exit 1
        ;;
esac
